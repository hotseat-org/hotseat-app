{
  "name": "remix-app-template",
  "private": true,
  "description": "",
  "license": "",
  "type": "module",
  "scripts": {
    "build": "bun run prisma:generate && react-router build && node scripts/nest-client-build.js",
    "dev": "react-router dev",
    "start": "vite preview",
    "postinstall": "bun run prisma:generate",
    "prisma:generate": "bunx prisma generate --config=./app/repositories/main-repository/prisma/prisma.config.ts",
    "prisma:reset": "bunx prisma migrate reset --config=./app/repositories/main-repository/prisma/prisma.config.ts",
    "prisma:migrate": "bunx prisma migrate dev --config=./app/repositories/main-repository/prisma/prisma.config.ts",
    "prisma:migrate:production": "node scripts/migrate-production.mjs",
    "prisma:studio": "bunx prisma studio --config=./app/repositories/main-repository/prisma/prisma.config.ts",
    "prisma:format": "bunx prisma format --config=./app/repositories/main-repository/prisma/prisma.config.ts",
    "prisma:validate": "bunx prisma validate --config=./app/repositories/main-repository/prisma/prisma.config.ts",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "typecheck": "bun run typegen:worker && react-router typegen && tsc --project ./tsconfig.json",
    "test": "bun test app/editor app/office app/examples app/utils",
    "deploy": "bun run build && wrangler deploy",
    "typegen:worker": "wrangler types --include-runtime=false",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@coji/remix-auth-google": "^4.2.0",
    "@heroui/react": "^3.0.1",
    "@heroui/styles": "^3.0.1",
    "@iconify/react": "^6.0.2",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "7.4.2",
    "@react-router/fs-routes": "^8.0.1",
    "@react-router/node": "^8.0.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/pluralize": "^0.0.33",
    "@uidotdev/usehooks": "^2.4.1",
    "@use-gesture/react": "10.3.1",
    "autoprefixer": "^10.4.27",
    "chalk": "^5.6.2",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.35.0",
    "install": "^0.13.0",
    "isbot": "^5.1.35",
    "lucide-react": "^0.577.0",
    "nanoid": "^5.1.6",
    "omggif": "^1.0.10",
    "pg": "^8.20.0",
    "pluralize": "^8.0.0",
    "pngjs": "^7.0.0",
    "prisma": "^7.4.2",
    "ramda": "^0.32.0",
    "react": "^19.2.7",
    "react-aria": "3.47.0",
    "react-dom": "^19.2.7",
    "react-router": "^8.0.1",
    "remix-auth": "^4.2.0",
    "remix-auth-github": "^3.0.2",
    "remix-auth-oauth2": "^3.4.1",
    "remix-themes": "^2.0.4",
    "remix-utils": "^9.1.0",
    "slugify": "^1.6.6",
    "three": "^0.185.1",
    "workers-og": "^0.0.27",
