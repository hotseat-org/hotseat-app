    "@iconify/json": "^2.2.446",
    "@iconify/tailwind4": "^1.2.3",
    "@react-router/dev": "^8.0.1",
    "@remix-run/eslint-config": "^2.17.4",
    "@tailwindcss/vite": "^4.2.1",
    "@types/bun": "1.3.4",
    "@types/node": "^25.3.3",
    "@types/omggif": "^1.0.5",
    "@types/pg": "^8.18.0",
    "@types/pngjs": "^6.0.5",
    "@types/ramda": "^0.31.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
