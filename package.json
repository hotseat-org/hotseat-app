    "tailwindcss": "4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.151.3"
  },
  "engines": {
    "node": ">=25"
  },
  "patchedDependencies": {
    "three@0.185.1": "patches/three@0.185.1.patch"
  }
}
