# Hotseat, self-hosted — copy to .env and fill in. See SELF_HOSTING.md.

# Where people open Hotseat (no trailing slash): sign-in providers send them back here.
BASE_URL=https://hotseat.example.com
# The port on this machine (put a reverse proxy with HTTPS in front of it).
PORT=3000

# Random and secret: signs sessions and upload links. e.g. `openssl rand -hex 32`
COOKIES_SECRET=
# The database's password (the database runs alongside, see compose.yml).
POSTGRES_PASSWORD=

# Who sets Hotseat up on their first sign-in (comma-separated). Empty: whoever signs in first.
HOTSEAT_ADMIN_EMAIL=

# Sign-in: set up at least one.
# OpenID Connect — Microsoft Entra, Google Workspace, Okta, Keycloak, Authentik…
# Redirect URI to register with it: {BASE_URL}/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# On its button: "Continue with …"
OIDC_NAME=

# Google — redirect URI: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub — callback URL: {BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
