# Hotseat, self-hosted: its settings. Save as .env next to compose.yml and fill in.
# Every setting: https://github.com/hotseat-org/hotseat-app/tree/main/docs/self-hosting/configuration.md

# The release to run (https://github.com/hotseat-org/hotseat-app/releases).
# Pin the exact one during the alpha: any release may change things.
HOTSEAT_VERSION=0.6.0-alpha

# Where people open Hotseat (no trailing slash): sign-in providers send them back here.
BASE_URL=https://hotseat.example.com
# The port on this machine (put a reverse proxy with HTTPS in front of it).
PORT=3000

# Random and secret: signs sessions and upload links. e.g. `openssl rand -hex 32`
COOKIES_SECRET=

# The database. Either the one Compose runs alongside (the default):
COMPOSE_PROFILES=database
POSTGRES_PASSWORD=
# …or your own Postgres (15+; Neon, RDS, Cloud SQL, a server of yours): remove
# COMPOSE_PROFILES above and set its connection string, e.g.
#   postgres://user:password@db.acme.com:5432/hotseat?sslmode=require
DATABASE_URL=

# Images (logos, office covers, people's photos). "local" (the default): on this
# server, in the images volume. "cloudflare": your Cloudflare Images account —
# fill in the four CLOUDFLARE_ settings below (see the guide's Configuration, Images).
IMAGE_STORAGE=local
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
CLOUDFLARE_IMAGE_KEY=
CLOUDFLARE_DELIVERY_URL=

# Who sets Hotseat up on their first sign-in (comma-separated). Empty: whoever signs in first.
HOTSEAT_ADMIN_EMAIL=

# Sign-in: set up at least one.
# OpenID Connect — Microsoft Entra, Google Workspace, Okta, Keycloak, Authentik…
# Redirect URI to register with it: {BASE_URL}/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# On its button: "Continue with …"
OIDC_NAME=

# Google — redirect URI: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub — callback URL: {BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
