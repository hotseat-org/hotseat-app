// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma-client"
  runtime  = "workerd"
}

// The same client for a plain Node server (self-hosting: HOTSEAT_TARGET=node
// builds use it in place of the one above — see vite.config.ts).
generator nodeClient {
  provider = "prisma-client"
  output   = "./generated/prisma-client-node"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model User {
  email    String    @unique
  profiles Profile[]

  displayName String
  avatarUrl   String?
  /// Desk pet (a model id from OfficeEditor/models.ts); null = derived from the email.
  pet         String?

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

enum Role {
  USER
  ADMIN
}

model Profile {
  userEmail        String
  user             User         @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  organizationSlug String
  organization     Organization @relation(fields: [organizationSlug], references: [slug], onDelete: Cascade)

  favoriteOfficeSlug String?
  favoriteOffice     Office? @relation(fields: [favoriteOfficeSlug, organizationSlug], references: [slug, organizationSlug])

  role Role

  reservations  Reservation[]
  deskReleases  DeskRelease[]
  favoriteDesks FavoriteDesk[]
  usualDesks    UsualDesk[]
  waitlist      WaitlistEntry[]
  seatRules     SeatRules[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userEmail, organizationSlug])
}

model Organization {
  slug     String               @id @unique
  name     String
  profiles Profile[]
  invites  OrganizationInvite[]
  offices  Office[]

  invitationHash String? @unique

  // Self-hosted: anyone signing in with an email at one of these domains
  // ("acme.com") joins as a member, no invite needed.
  allowedDomains String[] @default([])

  renamedFrom OrganizationSlugRedirect[]
  roomKits    RoomKit[]

  description String?
  thumbnail   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invitationHash])
}

model OrganizationInvite {
  expiresAt DateTime
  email     String

  organizationSlug String
  organization     Organization @relation(fields: [organizationSlug], references: [slug], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, organizationSlug])
}

model Office {
  slug String
  name String

  // Legacy Smplrspace id — no longer used (offices render via the R3F editor).
  spaceId String?

  thumbnail   String?
  description String?

  // 3D editor scene: array of placed objects (walls/doors/desks/seats/plants).
  layout Json?

  organizationSlug String
  organization     Organization @relation(fields: [organizationSlug], references: [slug], onDelete: Cascade)

  favoriteBy Profile[]

  // Desk booking. "Today" and "past" are judged in this IANA timezone; people
  // can book up to `bookingWindowDays` ahead.
  timezone          String               @default("Europe/Prague")
  bookingWindowDays Int                  @default(14)
  // The weekdays it's open for booking (ISO: 1 = Monday … 7 = Sunday).
  openWeekdays      Int[]                @default([1, 2, 3, 4, 5, 6, 7])
  closedDays        OfficeClosedDay[]
  reservations      Reservation[]
  deskReleases      DeskRelease[]
  favoriteDesks     FavoriteDesk[]
  usualDesks        UsualDesk[]
  waitlist          WaitlistEntry[]
  seatRules         SeatRules[]
  renamedFrom       OfficeSlugRedirect[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationSlug, slug])
}

// One person at one desk on one day. Desks with a permanent resident (the
// desk's `assignee` in Office.layout) are never booked; everything else is.
model Reservation {
  id String @id @default(cuid())

  organizationSlug String
  officeSlug       String
  office           Office @relation(fields: [organizationSlug, officeSlug], references: [organizationSlug, slug], onDelete: Cascade, onUpdate: Cascade)

  userEmail String
  profile   Profile @relation(fields: [userEmail, organizationSlug], references: [userEmail, organizationSlug], onDelete: Cascade, onUpdate: Cascade)

  // SceneObject.id inside Office.layout (JSON, so no FK — layout saves clean up).
  deskId String
  // The office's local calendar day (no time).
  date   DateTime @db.Date

  // Days booked together (a multi-day or repeating booking).
  seriesId       String?
  // Who made it — differs from userEmail when an admin books for someone.
  createdByEmail String

  createdAt DateTime @default(now())

  // One person per desk per day; one desk per person per day (across offices).
  @@unique([organizationSlug, officeSlug, deskId, date])
  @@unique([organizationSlug, userEmail, date])
  @@index([organizationSlug, officeSlug, date])
}

// Something that happened to someone's bookings or membership because of what
// another person did (an admin's layout change, a deleted office…) — shown
// under the bell. No emails: in-app only.
model Notification {
  id String @id @default(cuid())

  userEmail        String
  user             User    @relation(fields: [userEmail], references: [email], onDelete: Cascade, onUpdate: Cascade)
  // Where it happened (for the link); no FK, so it outlives a deleted org.
  organizationSlug String?

  message String
  // An in-app path to open, e.g. the office on that day.
  link    String?

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userEmail, createdAt])
}

// Old URLs keep working after a rename: an organization's earlier slugs. The
// FK follows later renames (ON UPDATE CASCADE), so a chain of renames still
// lands on the current slug.
model OrganizationSlugRedirect {
  oldSlug String @id

  slug         String
  organization Organization @relation(fields: [slug], references: [slug], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
}

// The same for an office's earlier slugs, within its organization.
model OfficeSlugRedirect {
  organizationSlug String
  oldSlug          String

  slug   String
  office Office @relation(fields: [organizationSlug, slug], references: [organizationSlug, slug], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@id([organizationSlug, oldSlug])
}

// A permanent resident giving their desk up for a day they're away: on that
// day it can be booked like any other desk. Goes with the resident's
// membership; a layout save drops releases whose desk changed hands.
model DeskRelease {
  organizationSlug String
  officeSlug       String
  office           Office   @relation(fields: [organizationSlug, officeSlug], references: [organizationSlug, slug], onDelete: Cascade, onUpdate: Cascade)
  deskId           String
  // The office's local calendar day.
  date             DateTime @db.Date

  userEmail String
  profile   Profile @relation(fields: [userEmail, organizationSlug], references: [userEmail, organizationSlug], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@id([organizationSlug, officeSlug, deskId, date])
}

// A day an office is closed (a holiday, a move): nobody books it, and
// bookings made before it was closed are cancelled.
model OfficeClosedDay {
  organizationSlug String
  officeSlug       String
  office           Office   @relation(fields: [organizationSlug, officeSlug], references: [organizationSlug, slug], onDelete: Cascade, onUpdate: Cascade)
  // The office's local calendar day.
  date             DateTime @db.Date
  // Why ("Christmas"), shown where the day is.
  reason           String?

  createdAt DateTime @default(now())

  @@id([organizationSlug, officeSlug, date])
}

// A desk someone likes: shown first to them, and tried first when a desk is
// booked for them automatically (usual desk taken, waitlist).
model FavoriteDesk {
  organizationSlug String
  officeSlug       String
  office           Office  @relation(fields: [organizationSlug, officeSlug], references: [organizationSlug, slug], onDelete: Cascade, onUpdate: Cascade)
  // SceneObject.id inside Office.layout.
  deskId           String
  userEmail        String
  profile          Profile @relation(fields: [userEmail, organizationSlug], references: [userEmail, organizationSlug], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@id([organizationSlug, officeSlug, userEmail, deskId])
}

// "My usual desk every Tue and Thu": booked automatically as those days open
// up for booking (a daily job). One per person per office.
model UsualDesk {
  organizationSlug String
  officeSlug       String
  office           Office    @relation(fields: [organizationSlug, officeSlug], references: [organizationSlug, slug], onDelete: Cascade, onUpdate: Cascade)
  userEmail        String
  profile          Profile   @relation(fields: [userEmail, organizationSlug], references: [userEmail, organizationSlug], onDelete: Cascade, onUpdate: Cascade)
  deskId           String
  // ISO weekdays: 1 = Monday … 7 = Sunday.
  weekdays         Int[]
  // Days up to here have been booked (or tried): later runs only book days
  // that newly opened up, so a day you cancelled stays cancelled.
  bookedThrough    DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([organizationSlug, officeSlug, userEmail])
}

// What someone looks for when finding a seat in an office ("in Marketing,
// ideally near Anna"): their rules, each a must or a preference — kept so
// they're there on any device. One per person per office.
model SeatRules {
  organizationSlug String
  officeSlug       String
  office           Office  @relation(fields: [organizationSlug, officeSlug], references: [organizationSlug, slug], onDelete: Cascade, onUpdate: Cascade)
  userEmail        String
  profile          Profile @relation(fields: [userEmail, organizationSlug], references: [userEmail, organizationSlug], onDelete: Cascade, onUpdate: Cascade)
  // [{ kind, strength, … }] — see app/office/findSeat/matching.ts (checked on the way in).
  rules            Json

  updatedAt DateTime @updatedAt

  @@id([organizationSlug, officeSlug, userEmail])
}

// Waiting for any desk on a full day: when one frees up, the first in line
// gets it booked for them.
model WaitlistEntry {
  organizationSlug String
  officeSlug       String
  office           Office   @relation(fields: [organizationSlug, officeSlug], references: [organizationSlug, slug], onDelete: Cascade, onUpdate: Cascade)
  userEmail        String
  profile          Profile  @relation(fields: [userEmail, organizationSlug], references: [userEmail, organizationSlug], onDelete: Cascade, onUpdate: Cascade)
  // The office's local calendar day.
  date             DateTime @db.Date

  createdAt DateTime @default(now())

  @@id([organizationSlug, officeSlug, userEmail, date])
  @@index([organizationSlug, officeSlug, date, createdAt])
}

// A saved room ("kit"): its walls, doors and windows and the furniture in it,
// to place again whole in any of the organization's offices. `objects` are
// Office.layout objects, positioned relative to the room's middle.
model RoomKit {
  id               String       @id
  organizationSlug String
  organization     Organization @relation(fields: [organizationSlug], references: [slug], onDelete: Cascade)
  name             String
  // Floor area, m².
  area             Float
  objects          Json
  createdBy        String

  createdAt DateTime @default(now())

  @@index([organizationSlug])
}
